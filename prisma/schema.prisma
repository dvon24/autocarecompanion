// AutoCare Companion Database Schema
// Epic 5: User Accounts & Monetization

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH MODELS (NextAuth.js compatible)
// ============================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  emailVerified      DateTime?
  image              String?
  passwordHash       String?

  // Stripe subscription
  stripeCustomerId   String?   @unique
  subscriptionId     String?
  subscriptionStatus String?   // active, canceled, past_due, trialing

  // Notification preferences
  emailNotifications Boolean   @default(true)
  pushNotifications  Boolean   @default(true)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  accounts           Account[]
  sessions           Session[]
  vehicles           Vehicle[]
  chatSessions       ChatSession[]
  insights           VehicleInsight[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// VEHICLE MODELS
// ============================================

model Vehicle {
  id                String    @id @default(cuid())
  userId            String

  // Vehicle info
  year              Int
  make              String
  model             String
  trim              String?
  vin               String?
  color             String?

  // Mileage tracking
  currentMileage    Int?
  lastMileageUpdate DateTime?
  annualMileage     Int?      // Estimated miles driven per year (for maintenance predictions)

  // User customization
  nickname          String?
  isPrimary         Boolean   @default(false)
  imageUrl          String?

  // Showcase settings
  isPublic          Boolean   @default(false)
  showcaseSlug      String?   @unique

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenanceRecords MaintenanceRecord[]
  modifications      Modification[]
  mileageHistory     MileageLog[]
  chatSessions       ChatSession[]

  @@index([userId])
}

model MileageLog {
  id        String   @id @default(cuid())
  vehicleId String
  mileage   Int
  source    String?  // manual, obd, estimated
  date      DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// ============================================
// MAINTENANCE MODELS
// ============================================

model MaintenanceRecord {
  id             String    @id @default(cuid())
  vehicleId      String

  // Maintenance details
  type           String    // oil_change, tire_rotation, brake_service, etc.
  description    String?
  mileage        Int
  cost           Float?
  date           DateTime

  // Next service tracking
  nextDueMileage Int?
  nextDueDate    DateTime?

  // Additional info
  notes          String?   @db.Text
  receiptUrl     String?
  shopName       String?

  createdAt      DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([type])
}

// ============================================
// MODIFICATION MODELS (for 3D visualizer & showcase)
// ============================================

model Modification {
  id          String    @id @default(cuid())
  vehicleId   String

  // Mod details
  category    String    // wheels, tires, suspension, exhaust, body, interior, performance
  name        String
  brand       String?
  partNumber  String?
  description String?   @db.Text
  cost        Float?
  installDate DateTime?

  // Media
  imageUrl    String?

  // 3D visualization data
  modelData   Json?     // wheel diameter, offset, width, color, etc.

  // Display order
  sortOrder   Int       @default(0)

  createdAt   DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([category])
}

// ============================================
// CHAT MODELS
// ============================================

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?  // null for anonymous users
  vehicleId String?

  // Chat data
  messages  Json     // Array of { role, content, timestamp }
  diagnosis Json?    // Final diagnosis if generated

  // Anonymous tracking (for rate limiting)
  anonymousId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([anonymousId])
  @@index([vehicleId, createdAt])
}

// ChatPromptInsight — write-only log of every prompt the chat sees,
// enriched with vehicle context. Powers the "Trending for your car"
// chip group in the hub by aggregating into TrendingIntent below.
// Anonymous prompts allowed (vehicleId is nullable).
model ChatPromptInsight {
  id            String   @id @default(cuid())
  vehicleYear   Int?
  make          String?
  model         String?
  trim          String?
  // Bucketed mileage so we don't fragment data across every odometer
  // reading. 0, 10000, 20000, ... in 10k-mi buckets.
  mileageBucket Int?
  prompt        String   @db.Text
  // Pre-classified intent (e.g. "maintenance.oil", "issue.transmission",
  // "drive.trip-planning"). Populated by a cheap classifier on insert
  // OR backfilled by the nightly aggregation cron.
  intent        String?
  promptTokens  Int?
  vehicleId     String?
  userId        String?
  anonymousId   String?
  createdAt     DateTime @default(now())

  @@index([make, model, mileageBucket])
  @@index([intent])
  @@index([createdAt])
}

// TrendingIntent — pre-aggregated trending questions by vehicle slice.
// Refreshed nightly from ChatPromptInsight. Read-heavy / write-occasionally
// shape so the hub can render "Drivers like you also asked..." instantly
// without aggregating at request time.
model TrendingIntent {
  id              String   @id @default(cuid())
  make            String
  model           String
  mileageBucket   Int
  intent          String
  count           Int
  exampleQuestion String   @db.Text
  lastSeen        DateTime
  refreshedAt     DateTime @default(now())

  @@unique([make, model, mileageBucket, intent])
  @@index([make, model, mileageBucket])
}

// ============================================
// NOTIFICATION MODELS
// ============================================

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  type      String   // maintenance_due, maintenance_overdue, weekly_summary
  channel   String   // email, push
  title     String
  body      String
  sentAt    DateTime @default(now())
  readAt    DateTime?

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================
// KNOWN ISSUE USER REPORTS
// ============================================

model UserIssueFix {
  id            String   @id @default(cuid())
  userId        String
  vehicleId     String

  // Link to the known issue
  knownIssueId  String
  knownIssue    KnownIssue? @relation(fields: [knownIssueId], references: [id], onDelete: SetNull)

  // Fix details
  status        String   // fixed, in_progress, wont_fix
  solution      String?  @db.Text  // User's description of how they fixed it
  cost          Float?             // How much they spent
  difficultyRating Int?            // 1-5 how hard was it
  partsUsed     String?  @db.Text  // Parts they used (freeform text)
  shopUsed      String?            // Shop name if they had it done professionally

  // Helpful for others
  tips          String?  @db.Text  // Any tips for others
  wouldRecommend Boolean @default(true)  // Would they recommend this fix to others

  // Visibility
  isPublic      Boolean  @default(true)  // Share with community

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, vehicleId, knownIssueId])
  @@index([knownIssueId])
  @@index([userId])
  @@index([vehicleId])
}

// ============================================
// GUIDE CACHE MODELS
// ============================================

model CachedGuide {
  id                String    @id @default(cuid())
  cacheKey          String    @unique  // "2019_chevrolet_camaro_zl1_oil_change"
  year              Int
  make              String
  model             String
  trim              String    @default("")
  maintenanceType   String               // "oil_change", "spark_plugs", etc.
  guideJson         Json                 // Full Guide object
  title             String               // Denormalized for admin list
  status            String    @default("auto-generated") // auto-generated | reviewed | verified
  reviewNotes       String?   @db.Text
  version           Int       @default(1)
  hitCount          Int       @default(0)
  lastHitAt         DateTime?
  generationCostUsd Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([make, model, maintenanceType])
  @@index([status])
}

model GuideCacheStats {
  id       String @id @default(cuid())
  date     String // YYYY-MM-DD
  hits     Int    @default(0)
  misses   Int    @default(0)
  savings  Float  @default(0)

  @@unique([date])
}

// ============================================
// KNOWN ISSUES (migrated from static JSON)
// ============================================

model KnownIssue {
  id                       String   @id  // e.g. "honda-civic-oil-dilution-2016"
  make                     String
  model                    String
  years                    Int[]
  trims                    String[]  @default([])
  engines                  String[]  @default([])
  category                 String
  title                    String
  description              String   @db.Text
  solution                 String   @db.Text
  severity                 String
  confidence               String   @default("medium")
  symptoms                 String[]  @default([])
  affectedSystems          String[]  @default([])
  dtcCodes                 String[]  @default([])
  estimatedCostLow         Int?
  estimatedCostHigh        Int?
  typicalMileageLow        Int?      // Mileage range when issue typically appears
  typicalMileageHigh       Int?
  citations                Json      @default("[]")
  communityRecommendations Json      @default("[]")
  humanApproved            Boolean   @default(false)
  reportCount              Int       @default(0)
  source                   String    @default("ai-researched")  // "nhtsa-verified", "ai-researched", "manual"
  status                   String    @default("published")
  lastReportedByOwners     String    @default("")
  reviewedOn               String    @default("")

  // Pre-computed semantic-similarity cross-links (other KnownIssue.id values)
  // populated by scripts/compute-issue-embeddings.js. Embedding lookup is
  // offline; render-time uses this column directly so cross-link lookup is
  // a simple JOIN with no vector math at request time. Bounded to top-K
  // (typically 5) and pre-filtered by shared component/engine/system.
  relatedIssueIds          String[]  @default([])

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  userFixes                UserIssueFix[]

  @@index([make, model])
  @@index([severity])
  @@index([status])
  @@index([category])
}

// ============================================
// OBD-II DTC CODE REFERENCE
// ============================================

model DTCCode {
  code         String   @id  // e.g. "P0300"
  name         String
  system       String
  description  String   @db.Text
  commonCauses String[]  @default([])
  severity     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([system])
}

// ============================================
// AFFILIATE CLICK TRACKING
// ============================================

model AffiliateClick {
  id                String   @id @default(cuid())
  knownIssueId      String
  recommendationIdx Int
  partBrand         String?
  partName          String?
  link              String?
  clickedAt         DateTime @default(now())

  @@index([knownIssueId])
  @@index([clickedAt])
}

model VehiclePartLookup {
  id                 String    @id @default(cuid())
  year               Int
  make               String
  model              String
  trim               String
  task               String    // e.g. "oil_change", "spark_plugs", "freetext:rocker panels"
  generation         String?   // e.g. "2015+ 6.4 SRT" — shared across years in same gen
  parts              Json      // Array of verified parts
  unverifiedParts    Json?     // Parts that failed web verification (for retry/learning)
  source             String    @default("ai") // "static" | "pipeline" | "pipeline-freetext"
  status             String    @default("pending") // "pending" | "verified" | "partial" | "failed"
  verifiedAt         DateTime?
  verificationLog    Json?     // Web search results, retry history
  webSearchConfirmed Boolean   @default(false)
  humanApproved      Boolean   @default(false)
  retryCount         Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([year, make, model, trim, task])
  @@index([make, model])
  @@index([status])
  @@index([generation])
}

model VehicleInsight {
  id          String   @id @default(cuid())
  userId      String?  // null for anonymous users; set when a logged-in user generated the insight
  year        Int
  make        String
  model       String
  trim        String?
  source      String   // "symptom_chat" | "parts_search" | "known_issue" | "community"
  insightType String   // "diagnosis" | "part_demand" | "part_confirmed" | "symptom_pattern"
  title       String   // e.g. "Warped front rotors", "Oil filter lookup"
  data        Json     // Flexible: { diagnosis, symptoms, partNumber, searchQuery, etc. }
  confidence  String?  // "high" | "medium" | "low"
  sessionHash String?
  country     String?  // ISO country code from x-vercel-ip-country
  occurrences Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([make, model])
  @@index([source])
  @@index([insightType])
  @@index([year, make, model])
  @@index([userId])
}
