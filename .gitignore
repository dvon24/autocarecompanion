# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE/Editor
.vscode/
.claude/

# PWA generated files (build artifacts from @ducanh2912/next-pwa).
# Globs cover the .map files and the swe-worker runtime too — these were
# half-tracked before, deploying stale orphaned maps to production.
public/sw.js*
public/workbox-*
public/swe-worker-*

.vercel

# Local data storage
/data/
!/data/
/data/*
!/data/known-issue-honda-final-adjudication-2026-08-12.json
!/data/known-issue-ymmt-policy.json
!/data/known-issue-ymmt-coverage-report.json

/src/generated/prisma
